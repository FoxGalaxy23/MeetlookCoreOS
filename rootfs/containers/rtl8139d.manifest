# rtl8139d.manifest -- см. CONTAINER_ARCHITECTURE.md (Фаза 4, подшаг 4) и
# include/netdrv.h за общей идеей.
#
# ВАЖНО: этот файл НЕ используется автоматическим запуском при старте.
# Ядро (kernel/netdrv.c: netdrv_launch()) строит манифест ПРЯМО В ПАМЯТИ,
# с РЕАЛЬНО обнаруженными на этой машине io_base/irq (BAR0 -- не константа,
# назначается BIOS/SeaBIOS заново при каждой загрузке), и передаёт их
# контейнеру через argv[1]/argv[2], а не через io_base=/irq= в файле на
# диске -- обычный манифест просто не может заранее знать значение,
# известное только в момент обнаружения карты.
#
# Этот файл -- ТОЛЬКО для ручной отладки ПОСЛЕ того, как автоматически
# запущенный контейнер упал (см. в консоли строку "netdrv: rtl8139d
# container exited"). НЕ запускайте его, пока автоматический экземпляр ещё
# жив: два контейнера, обслуживающих одну и ту же карту и линию IRQ
# одновременно, -- гонка за одни и те же регистры, а не резервирование
# (см. известное ограничение в kernel/irqbridge.c: "если ДВА разных
# контейнера когда-либо получат один и тот же irq=..."). Посмотрите точные
# io_base/irq в выводе консоли при загрузке (строка "net: RTL8139 at
# io=0x.. irq=..", kernel/netdrv.c) и передайте их вручную аргументами --
# io_base/io_len ниже в файле нужны лишь для того, чтобы дать САМОМУ
# запросу runc capability CAP_IO на этот диапазон портов; фактический
# io_base, с которым будет работать сам драйвер, определяется ТОЛЬКО
# первым аргументом командной строки, см. apps/rtl8139d.c:
#
#   > runc /containers/rtl8139d.manifest <io_base_в_десятичном> <irq>
#
# Значения ниже -- типичный вариант под QEMU (i440fx + SeaBIOS) по
# умолчанию, НЕ гарантированно совпадает с вашей машиной -- сверьтесь с
# консолью перед использованием.
name=rtl8139d
path=/bin/rtl8139d
caps=io,irq,net_bridge,shm
io_base=0xC000
io_len=0x100
irq=11
